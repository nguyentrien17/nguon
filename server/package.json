{
  "name": "server",
  "version": "1.0.0",
  "description": "API RBAC System",
  "main": "server.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "imports": {
    "#shared": "./shared.js",
    "#core/*": "./core/*.js",
    "#features/*": "./features/*.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node database/migrate.js",
    "smoke": "node tests/smoke.load.js",
    "test": "node --test tests/unit/*.test.js",
    "test:contract": "node tests/contract.api.js",
    "test:security": "node tests/users.security.js",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "knex": "3.3.0",
    "ms": "2.1.3",
    "mysql2": "3.24.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "nodemon": "3.1.14"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
