# development | production. PHẢI đặt production khi deploy thật: cờ Secure của cookie refresh
# token phụ thuộc vào biến này (features/auth/authController.js). Thiếu nó, server chỉ cảnh báo
# lúc khởi động chứ không dừng, nên rất dễ bị bỏ qua.
NODE_ENV=development
# error | warn | info | debug. Mặc định: debug ở development, info ở production.
LOG_LEVEL=debug
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Mặc định false (không tin X-Forwarded-For). Đặt true nếu chạy sau ĐÚNG 1 reverse proxy
# (nginx/Cloudflare...), hoặc một số nguyên = số proxy phía trước. Đặt true khi không có proxy
# thì client tự giả IP để vượt rate limit được.
TRUST_PROXY=false
# Số lần đăng nhập / quên / đặt lại mật khẩu tối đa mỗi phút mỗi IP (mặc định 5).
LOGIN_RATE_LIMIT_MAX=5
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_this_password
DB_NAME=rbac_portal
# Tối thiểu 32 ký tự và hai secret phải KHÁC nhau (production sẽ từ chối khởi động nếu không).
# Sinh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
